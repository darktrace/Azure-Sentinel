          { "name": "RuleDescription", "type": "string" },
          { "name": "DetectionMethod", "type": "string" },
          { "name": "ThreatCategory", "type": "string" },
          { "name": "ThreatConfidence", "type": "int" },
          { "name": "AttackTactics", "type": "string" },
