          { "name": "EntityId", "type": "string" },
          { "name": "EntityIdType", "type": "string" },
          { "name": "RawData", "type": "dynamic" },
          { "name": "AlertStatusChangedTime", "type": "datetime" },
          { "name": "EventOriginalSeverity", "type": "string" },
          { "name": "AlertOriginalStatus", "type": "string" },
