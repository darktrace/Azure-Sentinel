        "dataFlows": [
            {
                "streams": [
                "Custom-UnifiedAgentRisk_CL"
                ],
                "destinations": [
                "clv2ws1"
                ],
                "transformKql": "source | extend TimeGenerated = now() | project-rename TargetResourceId = ResourceId, TargetResourceType = ResourceType, TargetResourceName = ResourceName",
                "outputStream": "Microsoft-PartnerRiskEvents"
            },
            {
                "streams": [
                "Custom-DarktracePlatformModelAlerts"
                ],
                "destinations": [
                "clv2ws1"
                ],
                "transformKql": "source | extend TimeGenerated = now()",
